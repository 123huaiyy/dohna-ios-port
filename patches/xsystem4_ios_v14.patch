+			if (!libraries[i])
+				continue;
+			for (int j = 0; j < ain->libraries[i].nr_functions; j++)
+				free(libraries[i][j].args);
+			free(libraries[i]);
+		}
+		free(libraries);
+		libraries = NULL;
+	}
+	libraries_initialized = false;
+#ifdef XSYSTEM4_EMBEDDED
+	for (size_t i = nr_replaced_functions; i > 0; i--)
+		*replaced_functions[i - 1].slot = replaced_functions[i - 1].fun;
+	free(replaced_functions);
+	replaced_functions = NULL;
+	nr_replaced_functions = 0;
+#endif
+}
+
 void static_library_replace(struct static_library *lib, const char *name, void *fun)
 {
 	for (int i = 0; lib->functions[i].name; i++) {
 		if (!strcmp(lib->functions[i].name, name)) {
+#ifdef XSYSTEM4_EMBEDDED
+			replaced_functions = xrealloc_array(replaced_functions, nr_replaced_functions,
+					nr_replaced_functions + 1, sizeof(struct replaced_function));
+			replaced_functions[nr_replaced_functions++] = (struct replaced_function){
+				.slot = &lib->functions[i].fun,
+				.fun = lib->functions[i].fun,
+			};
+#endif
 			lib->functions[i].fun = fun;
 			return;
 		}
